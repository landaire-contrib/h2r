)

cxx_tools_info_toolchain(
    name = "cxx",
    cxx_tools_info = ":host_tools",
    c_flags = select({
        "DEFAULT": [],
        "config//os:windows": ["/nologo"],
    }),
    cxx_flags = select({
        "DEFAULT": [],
        "config//os:windows": ["/nologo"],
    }),
    link_flags = select({
        "DEFAULT": host_linker_flags(),
        "config//os:windows": ["/INCREMENTAL:NO"],
    }),
    visibility = ["PUBLIC"],
)

